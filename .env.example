# Juniper Mist API Token
# Get your token from: https://manage.mist.com > Organization > Settings > API Tokens
MIST_API_TOKEN=your_token_here

# Optional: Default organization ID
# If you want to set a default org, paste the UUID here
MIST_ORG_ID=

# API Base URL (usually don't need to change this)
# Default is Global 01 region. Change if using a different region.
# Examples: api.mist.com, api.ac2.mist.com, api.eu.mist.com
MIST_API_BASE_URL=https://api.mist.com/api/v1
